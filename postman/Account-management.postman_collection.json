{
    "info": {
        "name": "Clinic username and administrator management (isolated test database)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Creates a Clinic administrator and renames/restores that isolated account. Requires an existing administrator and two strong passwords. Use an isolated test database only."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8002"
        },
        {
            "key": "username",
            "value": ""
        },
        {
            "key": "password",
            "value": ""
        },
        {
            "key": "newPassword",
            "value": ""
        },
        {
            "key": "csrfToken",
            "value": ""
        },
        {
            "key": "createdAdminUsername",
            "value": ""
        },
        {
            "key": "renamedAdminUsername",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Initialize test names and CSRF",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/csrf/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "csrf",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);",
                            "const suffix = Date.now(); pm.collectionVariables.set(\"createdAdminUsername\", \"postman_admin_\" + suffix); pm.collectionVariables.set(\"renamedAdminUsername\", \"postman_admin_\" + suffix + \"_renamed\");"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Log in as existing admin",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get rotated CSRF",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/csrf/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "csrf",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "List administrators",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/admins/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "admins",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Creation rejects wrong actor password",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/admins/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "admins",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{createdAdminUsername}}\", \"password\": \"{{newPassword}}\", \"confirm_password\": \"{{newPassword}}\", \"current_password\": \"WrongCurrent!123\", \"first_name\": \"API\", \"last_name\": \"Administrator\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 400\", () => pm.response.to.have.status(400));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create additional Clinic admin",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/admins/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "admins",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{createdAdminUsername}}\", \"password\": \"{{newPassword}}\", \"confirm_password\": \"{{newPassword}}\", \"current_password\": \"{{password}}\", \"first_name\": \"API\", \"last_name\": \"Administrator\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
                            "pm.test(\"Clinic administrator role, no secrets\", () => { const body = pm.response.json(); pm.expect(body.role).to.eql(\"ADMIN\"); pm.expect(body).not.to.have.property(\"password\"); pm.expect(body).not.to.have.property(\"current_password\"); });"
                        ]
                    }
                }
            ]
        },
