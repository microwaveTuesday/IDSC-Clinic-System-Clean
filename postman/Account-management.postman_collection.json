                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"Session uses new username\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"renamedAdminUsername\")));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "New admin cannot access owner-only administrator directory",
