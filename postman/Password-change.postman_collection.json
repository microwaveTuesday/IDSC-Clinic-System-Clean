{
    "info": {
        "name": "Clinic self-service password change (isolated test account only)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Requires an isolated account and two strong passwords. Changes and restores that account password. Never run against a real user."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8002"
        },
        {
            "key": "username",
            "value": ""
        },
        {
            "key": "password",
            "value": ""
        },
        {
            "key": "newPassword",
            "value": ""
        },
        {
            "key": "csrfToken",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Get CSRF for login",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/csrf/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "csrf",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Log in with original password",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get rotated CSRF",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/csrf/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "csrf",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Change password",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/password/change/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "password",
                        "change",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"current_password\": \"{{password}}\", \"new_password\": \"{{newPassword}}\", \"confirm_password\": \"{{newPassword}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"No password in response\", () => pm.expect(Object.keys(pm.response.json())).to.eql([\"message\"]));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Current session remains signed in",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/me/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "me",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Log out",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/logout/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "logout",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Original password is rejected",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "New password signs in",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/login/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"username\": \"{{username}}\", \"password\": \"{{newPassword}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get CSRF before restoring account",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/csrf/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "csrf",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Restore isolated account password",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/password/change/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "password",
                        "change",
                        ""
                    ]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\"current_password\": \"{{newPassword}}\", \"new_password\": \"{{password}}\", \"confirm_password\": \"{{password}}\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"No password in response\", () => pm.expect(Object.keys(pm.response.json())).to.eql([\"message\"]));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Log out after restore",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/auth/logout/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "logout",
                        ""
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        }
    ]
}
