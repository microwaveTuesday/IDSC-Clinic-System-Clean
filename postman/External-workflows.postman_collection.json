            "name": "Create unused medicine",
            "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/v1/mock/inventory/medicines/",
                "header": [
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"medicine_id\": \"{{unusedId}}\", \"name\": \"API Medicine\", \"generic_name\": \"Test\", \"unit\": \"tablet\", \"quantity_in_stock\": 0, \"reorder_level\": 5, \"status\": \"ACTIVE\"}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Delete unused medicine",
            "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/v1/mock/inventory/medicines/{{unusedId}}/",
                "header": [
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ]
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Deleted medicine absent in Clinic",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/v1/medicines/{{unusedId}}/",
                "header": []
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Owner logout",
            "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/logout/",
                "header": [
                    {
                        "key": "X-CSRFToken",
                        "value": "{{csrfToken}}"
                    }
                ]
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        }
    ]
}
