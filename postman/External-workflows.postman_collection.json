{
    "info": {
        "name": "Registrar Inventory and Clinic workflows",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Run with disposable Owner credentials on a mock backend. Profile updates, status gating, catalog notifications, selected/all restock, idempotent delivery and stock-preserving history deletion."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8002"
        },
        {
            "key": "username",
            "value": ""
        },
        {
            "key": "password",
            "value": ""
        },
        {
            "key": "csrfToken",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Get CSRF",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/auth/csrf/",
                "header": []
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                            "pm.collectionVariables.set(\"csrfToken\",pm.response.json().csrfToken);"
                        ]
                    }
                }
            ]
        },
        {
