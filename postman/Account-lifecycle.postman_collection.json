{
  "info": {
    "name": "Clinic account lifecycle (disposable database only)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Creates isolated staff/admin accounts, deactivates/reactivates and permanently deletes them. Requires an existing system administrator and two strong test passwords."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "suffix",
      "value": ""
    },
    {
      "key": "actorId",
      "value": ""
    },
    {
      "key": "adminId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Initialize isolated accounts and CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/csrf/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "csrf",
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);",
              "pm.collectionVariables.set(\"suffix\", Date.now());"
            ]
          }
        }
      ]
    },
    {
      "name": "Log in acting system admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRFToken",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get current CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
