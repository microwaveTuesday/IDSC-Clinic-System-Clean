            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Owner role and protected account ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Owner role\",()=>pm.expect(pm.response.json().role).to.eql(\"OWNER\"));",
              "pm.collectionVariables.set(\"ownerId\",pm.response.json().id);",
              "pm.collectionVariables.set(\"adminName\",\"roles_admin_\"+Date.now());",
              "pm.collectionVariables.set(\"staffName\",\"roles_staff_\"+Date.now());"
            ]
          }
        }
      ]
    },
    {
