          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admins/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{adminName}}\", \"password\": \"{{newPassword}}\", \"confirm_password\": \"{{newPassword}}\", \"current_password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"adminId\",pm.response.json().user_id);",
              "pm.test(\"Regular admin\",()=>pm.expect(pm.response.json().role).to.eql(\"ADMIN\"));"
            ]
