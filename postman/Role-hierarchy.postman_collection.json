{
  "info": {
    "name": "Owner Admin Staff hierarchy",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Owner-only admin management; Owner/Admin staff management; Staff clinic access; owner protection. Use disposable owner credentials."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get current CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in {{username}}",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRFToken",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login/",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get current CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf/"
      },
      "event": [
        {
          "listen": "test",
