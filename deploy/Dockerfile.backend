FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY backend/requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-deployment.txt
COPY backend/ ./
RUN useradd --create-home clinic && mkdir /data /static && chown clinic:clinic /data /static
USER clinic
EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py collectstatic --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 1 --threads 1 --access-logfile - --error-logfile - --timeout 60"]
