{$CLINIC_HOST:localhost} {
    tls internal
    encode gzip
    @backend path /api/* /admin/* /docs /docs/
    handle @backend {
        reverse_proxy backend:8000
    }
    handle_path /static/* {
        root * /static
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
