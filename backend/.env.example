# Django Configuration
# SECRET_KEY must be privately generated for DEBUG=False deployments.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite development with persistent Clinic records.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=framework.sqlite3
# For PostgreSQL install requirements-finals.txt and privately configure:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=clinic_db
# DB_USER=clinic_app
# DB_PASSWORD=your-private-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# database persists Clinic-owned resources; mock keeps isolated demos.
CLINIC_DATA_BACKEND=database
CLINIC_EMPTY_START=0
